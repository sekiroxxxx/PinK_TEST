{
  "kind": "pink-configuration-steps",
  "schemaVersion": 1,
  "cases": [
    {
      "caseId": "steps.web-desktop.edited",
      "platform": "web-desktop",
      "steps": [
        { "id": "original", "op": "record", "fields": ["name", "debug"] },
        { "id": "debug", "op": "set", "field": "debug", "value": true },
        { "id": "rename", "op": "set", "field": "name", "value": "qa_steps_edited" },
        { "id": "current", "op": "read", "fields": ["name", "debug"] },
        {
          "id": "check",
          "op": "assert",
          "check": "values",
          "snapshot": "current",
          "values": { "name": "qa_steps_edited", "debug": true }
        },
        {
          "id": "prompt",
          "op": "assert",
          "check": "prompt",
          "field": "name",
          "expected": { "kind": "none" }
        },
        {
          "id": "editable",
          "op": "assert",
          "check": "state",
          "field": "name",
          "expected": { "visible": true, "disabled": false }
        },
        { "id": "restore", "op": "restore", "record": "original" }
      ]
    }
  ]
}
