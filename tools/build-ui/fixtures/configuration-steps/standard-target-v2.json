{
  "kind": "pink-configuration-steps",
  "schemaVersion": 2,
  "targets": [
    {
      "id": "qa-standard-platform",
      "label": "QA Standard Platform",
      "configurationTitle": "QA Standard Platform",
      "category": "X-Application",
      "fields": {
        "qaSwitch": {
          "kind": "boolean",
          "control": "boolean",
          "locator": { "kind": "label", "name": "新增开关" },
          "scope": { "readyKeys": ["name", "buildPath"] }
        },
        "qaMode": {
          "kind": "string",
          "control": "enum",
          "locator": { "kind": "option-key", "key": "packages.qa-standard-platform.mode" },
          "scope": { "readyKeys": ["name", "buildPath"] }
        },
        "qaRemoved": {
          "kind": "string",
          "control": "text",
          "locator": { "kind": "option-key", "key": "packages.qa-standard-platform.removed" },
          "scope": { "readyKeys": ["name", "buildPath"] }
        }
      }
    }
  ],
  "cases": [
    {
      "caseId": "qa.standard.edited",
      "platform": "qa-standard-platform",
      "steps": [
        { "id": "platform", "op": "platform.probe" },
        {
          "id": "platform-present",
          "op": "assert",
          "check": "probe",
          "observation": "platform",
          "expected": { "presence": "present", "visible": true }
        },
        { "id": "open", "op": "config.open" },
        { "id": "ready", "op": "config.ready", "page": "open" },
        { "id": "new-field", "op": "config.probe", "page": "open", "field": "qaSwitch" },
        {
          "id": "field-present",
          "op": "assert",
          "check": "probe",
          "observation": "new-field",
          "expected": {
            "presence": "present",
            "visible": true,
            "writable": true,
            "control": "boolean"
          }
        },
        { "id": "original", "op": "record", "page": "open", "fields": ["qaSwitch", "qaMode"] },
        { "id": "switch", "op": "set", "page": "open", "field": "qaSwitch", "value": true },
        { "id": "choices", "op": "config.candidates", "page": "open", "field": "qaMode" },
        {
          "id": "new-choice",
          "op": "assert",
          "check": "candidate",
          "observation": "choices",
          "candidate": { "by": "value", "value": "qa-added" },
          "expected": { "present": true }
        },
        {
          "id": "removed-choice",
          "op": "assert",
          "check": "candidate",
          "observation": "choices",
          "candidate": { "by": "value", "value": "removed" },
          "expected": { "present": false }
        },
        {
          "id": "select",
          "op": "config.select",
          "page": "open",
          "field": "qaMode",
          "candidate": { "by": "label", "label": "QA 新候选" }
        },
        { "id": "current", "op": "read", "page": "open", "fields": ["qaSwitch", "qaMode"] },
        {
          "id": "values",
          "op": "assert",
          "check": "values",
          "snapshot": "current",
          "values": { "qaSwitch": true, "qaMode": "qa-added" }
        },
        { "id": "removed-field", "op": "config.probe", "page": "open", "field": "qaRemoved" },
        {
          "id": "field-absent",
          "op": "assert",
          "check": "probe",
          "observation": "removed-field",
          "expected": { "presence": "absent" }
        }
      ],
      "finally": [
        { "id": "cleanup", "op": "config.open" },
        { "id": "restore", "op": "restore", "page": "cleanup", "record": "original" },
        { "id": "close", "op": "config.close", "page": "cleanup" }
      ]
    }
  ]
}
