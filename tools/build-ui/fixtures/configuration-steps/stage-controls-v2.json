{
  "kind": "pink-configuration-steps",
  "schemaVersion": 2,
  "cases": [
    {
      "caseId": "UI-P07-S01.wechat",
      "platform": "wechatgame",
      "onFailure": "continue",
      "steps": [
        {
          "id": "page",
          "op": "config.open"
        },
        {
          "id": "fields",
          "op": "record",
          "page": "page",
          "fields": ["name", "startScene", "scenes"]
        },
        {
          "id": "original",
          "op": "stage.record",
          "page": "page"
        },
        {
          "id": "initialRead",
          "op": "stage.read",
          "page": "page"
        },
        {
          "id": "initial",
          "op": "assert",
          "check": "stages",
          "snapshot": "initialRead",
          "expected": {
            "groups": [["build", "run"]]
          }
        },
        {
          "id": "prepareSplit",
          "op": "stage.unlink",
          "page": "page",
          "record": "original",
          "group": "build",
          "stage": "run"
        },
        {
          "id": "separateRead",
          "op": "stage.read",
          "page": "page"
        },
        {
          "id": "separate",
          "op": "assert",
          "check": "stages",
          "snapshot": "separateRead",
          "expected": {
            "groups": [["build"], ["run"]],
            "disabled": {
              "build": false,
              "run": true
            },
            "linkDisabled": {
              "run": false
            }
          }
        },
        {
          "id": "connectHint",
          "op": "stage.hint",
          "page": "page",
          "control": "link",
          "stage": "run",
          "contains": "链接到上一个阶段"
        },
        {
          "id": "join",
          "op": "stage.link",
          "page": "page",
          "record": "original",
          "previous": "build",
          "stage": "run"
        },
        {
          "id": "joinedRead",
          "op": "stage.read",
          "page": "page"
        },
        {
          "id": "joined",
          "op": "assert",
          "check": "stages",
          "snapshot": "joinedRead",
          "expected": {
            "groups": [["build", "run"]]
          }
        },
        {
          "id": "unlinkHint",
          "op": "stage.hint",
          "page": "page",
          "control": "unlink",
          "stage": "run",
          "contains": "断开链接"
        },
        {
          "id": "closeForPersistence",
          "op": "config.close",
          "page": "page"
        },
        {
          "id": "reopened",
          "op": "config.open"
        },
        {
          "id": "persistedRead",
          "op": "stage.read",
          "page": "reopened"
        },
        {
          "id": "persisted",
          "op": "assert",
          "check": "stages",
          "snapshot": "persistedRead",
          "expected": {
            "groups": [["build", "run"]]
          }
        },
        {
          "id": "split",
          "op": "stage.unlink",
          "page": "reopened",
          "record": "original",
          "group": "build",
          "stage": "run"
        },
        {
          "id": "splitCheckedRead",
          "op": "stage.read",
          "page": "reopened"
        },
        {
          "id": "splitChecked",
          "op": "assert",
          "check": "stages",
          "snapshot": "splitCheckedRead",
          "expected": {
            "groups": [["build"], ["run"]]
          }
        }
      ],
      "finally": [
        {
          "id": "cleanup",
          "op": "config.open"
        },
        {
          "id": "restoreStages",
          "op": "stage.restore",
          "page": "cleanup",
          "record": "original",
          "reopen": true
        },
        {
          "id": "restoreFields",
          "op": "restore",
          "page": "cleanup",
          "record": "fields"
        },
        {
          "id": "close",
          "op": "config.close",
          "page": "cleanup"
        }
      ]
    },
