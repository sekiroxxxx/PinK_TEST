        },
        {
          "id": "rename",
          "op": "set",
          "field": "name",
          "value": "must_never_be_written"
        },
        {
          "id": "current",
          "op": "read",
          "fields": ["name"]
        },
        {
          "id": "check",
          "op": "assert",
          "check": "values",
          "snapshot": "current",
          "values": {
            "name": "must_never_be_written"
          }
        },
        {
          "id": "restore",
