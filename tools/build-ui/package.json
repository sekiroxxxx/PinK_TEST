{
  "name": "pink-build-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows PinK UI build runner with base debug and release profiles for eighteen platforms",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json README.md",
    "format:check": "prettier --check src package.json tsconfig.json README.md",
    "report": "node dist/report-cli.js",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "playwright-core": "1.61.0-alpha-2026-06-04"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
