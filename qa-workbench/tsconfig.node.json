{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "src",
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/integrations",
    "src/development"
  ]
}
