{
  "name": "qa-workbench",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "tsc -p tsconfig.node.json && node scripts/dev.mjs",
    "build": "npm run check && tsc -p tsconfig.node.json && vite build",
    "start": "electron .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write src scripts *.json *.ts *.html README.md",
    "format:check": "prettier --check src scripts *.json *.ts *.html README.md",
    "dev:web": "vite",
    "dev:web:live": "tsc -p tsconfig.node.json && node scripts/dev-web-live.mjs",
    "package:trial": "npm run build && node scripts/package-trial.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
